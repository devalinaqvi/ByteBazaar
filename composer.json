{
  "name": "vendor/computer-zone",
  "type": "project",
  "description": "Online Computer Store MVC",
  "require": {
    "altorouter/altorouter": "^2.0",
    "ext-pdo": "*",
    "php": "^8.2",
    "ext-mbstring": "*",
    "ext-fileinfo": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "scripts": {
